{
  "name": "@sheetflare/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "npm --prefix ../admin run build",
    "dev": "npm run build:admin && wrangler dev",
    "build": "npm run build:admin && wrangler deploy --dry-run",
    "deploy": "npm run build:admin && wrangler deploy --config wrangler.jsonc",
    "deploy:staging": "npm run build:admin && wrangler deploy --config wrangler.staging.jsonc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.14",
    "@sheetflare/cloudflare": "*",
    "@sheetflare/contracts": "*",
    "hono": "^4.13.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "wrangler": "^4.153.0"
  }
}
